# Copy to .env locally. Never paste secrets into the chat or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Live mode requires this explicit data-sharing opt-in.
ALLOW_GOOGLE_DEVICE_DATA=false
AI_PROVIDER_ORDER=gemini,openrouter
OPENROUTER_API_KEY=
# Free router by default; changing this to a paid model can incur charges.
OPENROUTER_MODEL=openrouter/free
ALLOW_OPENROUTER_DEVICE_DATA=false

# Use a dedicated account with device/AAA read-only command authorization.
# Do not use the privilege-15 admin account for a read-only deployment.
NETWORK_USERNAME=
NETWORK_PASSWORD=
# Optional encrypted private key and its passphrase, instead of a password.
NETWORK_KEY_FILE=
NETWORK_KEY_PASSPHRASE=

# Optional per-device overrides, for example:
# R1_USERNAME=
# R1_PASSWORD=
# R1_KEY_FILE=
# R1_KEY_PASSPHRASE=
