# --- Mode --------------------------------------------------------------
# MOCK=true runs everything with canned data: no devices, Kusto or OpenAI needed.
NETOPS_MOCK=true

# --- Azure OpenAI (AI validation + agent) ------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01
# Leave empty to use Entra ID (managed identity / az login) instead of a key.
AZURE_OPENAI_API_KEY=

# --- Kusto -------------------------------------------------------------
KUSTO_CLUSTER=https://<cluster>.kusto.windows.net
KUSTO_DATABASE=<database>

# --- Device credentials (read-only TACACS account) ---------------------
# Preferred: Key Vault. The service identity needs 'get' on these secrets.
KEYVAULT_URL=https://<vault>.vault.azure.net
KEYVAULT_USERNAME_SECRET=netops-ro-username
KEYVAULT_PASSWORD_SECRET=netops-ro-password
# Fallback for lab only:
# DEVICE_USERNAME=
# DEVICE_PASSWORD=

# --- Limits ------------------------------------------------------------
DEVICE_COMMAND_TIMEOUT=60
MAX_PARALLEL_DEVICE_SESSIONS=4
AGENT_MAX_STEPS=6
# Comma-separated UPNs allowed to use the tool (empty = anyone who passes SSO)
ALLOWED_USERS=
AUDIT_LOG=audit.jsonl
