APP_ENV=development
APP_ORIGIN=https://127.0.0.1:8000
# The --private-tunnel launcher configures these for its own process only.
TRANSPORT_MODE=direct_tls
DATA_DIR=data
MODEL_DIR=models
ALLOW_DEMO_MODELS=true
SESSION_HOURS=8
# Keep disabled unless the user explicitly consents per chat request.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# Add your NVIDIA-hosted API key locally. Never commit a real key.
# A configured NVIDIA key takes priority; otherwise existing Azure configuration is preserved.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Prioritized fallback pool; overrides NVIDIA_MODEL when nonempty. At most five models are tried.
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3.5-super-vl-120b-a12b
